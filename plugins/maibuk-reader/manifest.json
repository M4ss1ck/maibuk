{
  "manifestVersion": 1,
  "id": "maibuk-reader",
  "name": "Reader",
  "description": "Reads PDF, EPUB, MOBI, AZW3, FB2, and CBZ files from your device beside your writing, and remembers where you were.",
  "author": "Maibuk",
  "version": "0.2.0",
  "apiVersion": "^0.1.15",
  "entry": "index.js",
  "platforms": ["desktop", "web", "android"],
  "lifecycle": "on-demand",
  "warmStart": "intent",
  "customUi": true,
  "frameEntry": { "source": "frame/entry.ts", "bundle": "assets/ui/reader.js" },
  "defaultLanguage": "en",
  "permissions": {
    "required": ["files:pick"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openReader",
        "label": "Open Reader",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "openFile",
        "label": "Open file…",
        "contexts": ["global"]
      },
      {
        "id": "openDocument",
        "label": "Open Document",
        "contexts": ["reader"],
        "navigates": true
      },
      {
        "id": "nextPage",
        "label": "Next page",
        "contexts": ["document", "reader"]
      },
      {
        "id": "previousPage",
        "label": "Previous page",
        "contexts": ["document", "reader"]
      },
      {
        "id": "firstPage",
        "label": "First page",
        "contexts": ["document", "reader"]
      },
      {
        "id": "lastPage",
        "label": "Last page",
        "contexts": ["document", "reader"]
      },
      {
        "id": "findInDocument",
        "label": "Find in Document",
        "contexts": ["document", "reader"]
      },
      {
        "id": "toggleContents",
        "label": "Toggle contents",
        "contexts": ["document", "reader"]
      },
      {
        "id": "zoomIn",
        "label": "Zoom in",
        "contexts": ["document", "reader"]
      },
      {
        "id": "zoomOut",
        "label": "Zoom out",
        "contexts": ["document", "reader"]
      },
      {
        "id": "fitWidth",
        "label": "Fit width",
        "contexts": ["document", "reader"]
      },
      {
        "id": "fitPage",
        "label": "Fit page",
        "contexts": ["document", "reader"]
      },
      {
        "id": "increaseFontSize",
        "label": "Increase font size",
        "contexts": ["document", "reader"]
      },
      {
        "id": "decreaseFontSize",
        "label": "Decrease font size",
        "contexts": ["document", "reader"]
      },
      {
        "id": "toggleContinuousScroll",
        "label": "Continuous scroll",
        "contexts": ["document", "reader"]
      },
      {
        "id": "backToShelf",
        "label": "Back to Shelf",
        "contexts": ["document", "reader"]
      },
      {
        "id": "removeFromShelf",
        "label": "Remove from Shelf…",
        "contexts": ["reader"]
      },
      {
        "id": "locateDocument",
        "label": "Locate",
        "contexts": ["reader"]
      }
    ],
    "pages": [
      {
        "id": "reader",
        "title": "Reader",
        "command": "openReader",
        "frame": "assets/ui/shelf.html",
        "hideTitle": true
      },
      {
        "id": "document",
        "title": "Reading",
        "command": "openDocument",
        "frame": "assets/ui/reader.html",
        "hideTitle": true,
        "hideBack": true
      }
    ],
    "sidebarEntries": [{ "page": "reader", "icon": "book-open-text" }],
    "canvasReferenceSources": [
      { "id": "documents", "label": "Documents", "icon": "book-open-text", "preview": "portrait" }
    ]
  }
}
