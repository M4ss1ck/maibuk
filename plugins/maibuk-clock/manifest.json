{
  "manifestVersion": 1,
  "id": "maibuk-clock",
  "name": "Clock",
  "description": "Time your work with a Pomodoro cycle, a Timer, a Stopwatch, and Alarms.",
  "author": "Maibuk",
  "version": "0.1.0",
  "apiVersion": "^0.1.16",
  "entry": "index.js",
  "platforms": ["desktop", "web", "android"],
  "lifecycle": "persistent",
  "customUi": true,
  "defaultLanguage": "en",
  "permissions": {
    "required": ["system-notifications"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openClock",
        "label": "Open Clock",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "toggleTimer",
        "label": "Start or pause the Timer",
        "contexts": ["global"]
      },
      {
        "id": "togglePomodoro",
        "label": "Start or pause the Pomodoro",
        "contexts": ["global"]
      },
      {
        "id": "skipPomodoro",
        "label": "Skip to the next Pomodoro or break",
        "contexts": ["global"]
      },
      {
        "id": "openPomodoroSettings",
        "label": "Pomodoro settings",
        "contexts": ["global"]
      },
      {
        "id": "toggleStopwatch",
        "label": "Start or pause the Stopwatch",
        "contexts": ["global"]
      },
      {
        "id": "lapStopwatch",
        "label": "Mark a Lap",
        "contexts": ["global"]
      }
    ],
    "pages": [
      {
        "id": "clock",
        "title": "Clock",
        "command": "openClock",
        "frame": "assets/ui/clock.html",
        "hideTitle": true
      }
    ],
    "sidebarEntries": [{ "page": "clock", "icon": "timer" }],
    "toolbarButtons": [
      {
        "id": "togglePomodoro",
        "command": "togglePomodoro",
        "icon": {
          "elements": [
            ["line", { "x1": "10", "y1": "2", "x2": "14", "y2": "2" }],
            ["line", { "x1": "12", "y1": "14", "x2": "15", "y2": "11" }],
            ["circle", { "cx": "12", "cy": "14", "r": "8" }]
          ]
        },
        "toggle": true
      }
    ],
    "settingsRows": [
      {
        "id": "pomodoro",
        "label": "Pomodoro",
        "description": "Set how long Pomodoros and breaks last, and whether they start on their own."
      }
    ]
  }
}
