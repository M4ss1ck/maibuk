{
  "manifestVersion": 1,
  "id": "maibuk-clock",
  "name": "Clock",
  "description": "Time your work with a Pomodoro cycle, a Timer, a Stopwatch, and Alarms.",
  "author": "Maibuk",
  "version": "0.1.0",
  "apiVersion": "^0.1.16",
  "entry": "index.js",
  "platforms": ["desktop", "web", "android"],
  "lifecycle": "persistent",
  "defaultLanguage": "en",
  "permissions": {
    "required": ["system-notifications"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openClock",
        "label": "Open Clock",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "toggleTimer",
        "label": "Start or pause the Timer",
        "contexts": ["global"]
      }
    ],
    "pages": [{ "id": "clock", "title": "Clock", "command": "openClock" }],
    "sidebarEntries": [{ "page": "clock", "icon": "timer" }]
  }
}
