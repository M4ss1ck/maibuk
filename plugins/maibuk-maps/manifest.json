{
  "manifestVersion": 1,
  "id": "maibuk-maps",
  "name": "Maps",
  "description": "Design maps of your world, a region, or a country and its provinces, in color or print-ready ink.",
  "author": "Maibuk",
  "version": "0.5.0",
  "apiVersion": "^0.1.11",
  "entry": "index.js",
  "platforms": ["web", "desktop"],
  "lifecycle": "on-demand",
  "warmStart": "intent",
  "customUi": true,
  "dataVersion": 1,
  "defaultLanguage": "en",
  "permissions": {
    "required": ["library:read", "editor:write", "files:pick", "files:save"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openMaps",
        "label": "Open Maps",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "bookMaps",
        "label": "Maps",
        "contexts": ["bookEditor"],
        "targets": ["book"]
      },
      {
        "id": "openMap",
        "label": "Open Map",
        "contexts": ["maps"],
        "navigates": true
      },
      {
        "id": "undo",
        "label": "Undo",
        "contexts": ["map"],
        "defaults": [["Mod+z"]]
      },
      {
        "id": "redo",
        "label": "Redo",
        "contexts": ["map"],
        "defaults": [["Mod+Shift+z"], ["Mod+y"]]
      },
      {
        "id": "zoomIn",
        "label": "Zoom in",
        "contexts": ["map"],
        "defaults": [["Mod+="], ["Mod++"]]
      },
      {
        "id": "zoomOut",
        "label": "Zoom out",
        "contexts": ["map"],
        "defaults": [["Mod+-"]]
      },
      {
        "id": "zoomReset",
        "label": "Reset zoom",
        "contexts": ["map"],
        "defaults": [["Mod+0"]]
      },
      {
        "id": "panLeft",
        "label": "Pan left",
        "contexts": ["map"],
        "defaults": [["Alt+ArrowLeft"]]
      },
      {
        "id": "panRight",
        "label": "Pan right",
        "contexts": ["map"],
        "defaults": [["Alt+ArrowRight"]]
      },
      {
        "id": "panUp",
        "label": "Pan up",
        "contexts": ["map"],
        "defaults": [["Alt+ArrowUp"]]
      },
      {
        "id": "panDown",
        "label": "Pan down",
        "contexts": ["map"],
        "defaults": [["Alt+ArrowDown"]]
      },
      {
        "id": "moveLeft",
        "label": "Move left",
        "contexts": ["map"],
        "defaults": [["ArrowLeft"]]
      },
      {
        "id": "moveRight",
        "label": "Move right",
        "contexts": ["map"],
        "defaults": [["ArrowRight"]]
      },
      {
        "id": "moveUp",
        "label": "Move up",
        "contexts": ["map"],
        "defaults": [["ArrowUp"]]
      },
      {
        "id": "moveDown",
        "label": "Move down",
        "contexts": ["map"],
        "defaults": [["ArrowDown"]]
      },
      {
        "id": "moveLeftFar",
        "label": "Move left 10 mm",
        "contexts": ["map"],
        "defaults": [["Shift+ArrowLeft"]]
      },
      {
        "id": "moveRightFar",
        "label": "Move right 10 mm",
        "contexts": ["map"],
        "defaults": [["Shift+ArrowRight"]]
      },
      {
        "id": "moveUpFar",
        "label": "Move up 10 mm",
        "contexts": ["map"],
        "defaults": [["Shift+ArrowUp"]]
      },
      {
        "id": "moveDownFar",
        "label": "Move down 10 mm",
        "contexts": ["map"],
        "defaults": [["Shift+ArrowDown"]]
      },
      {
        "id": "scaleUp",
        "label": "Scale up",
        "contexts": ["map"],
        "defaults": [["]"]]
      },
      {
        "id": "scaleDown",
        "label": "Scale down",
        "contexts": ["map"],
        "defaults": [["["]]
      },
      {
        "id": "scaleUpFine",
        "label": "Scale up 1%",
        "contexts": ["map"],
        "defaults": [["Shift+]"]]
      },
      {
        "id": "scaleDownFine",
        "label": "Scale down 1%",
        "contexts": ["map"],
        "defaults": [["Shift+["]]
      },
      {
        "id": "rotateClockwise",
        "label": "Rotate clockwise",
        "contexts": ["map"],
        "defaults": [["."]]
      },
      {
        "id": "rotateCounterClockwise",
        "label": "Rotate counterclockwise",
        "contexts": ["map"],
        "defaults": [[","]]
      },
      {
        "id": "rotateClockwiseFine",
        "label": "Rotate clockwise 1°",
        "contexts": ["map"],
        "defaults": [["Shift+."]]
      },
      {
        "id": "rotateCounterClockwiseFine",
        "label": "Rotate counterclockwise 1°",
        "contexts": ["map"],
        "defaults": [["Shift+,"]]
      },
      {
        "id": "selectTool",
        "label": "Select tool",
        "contexts": ["map"],
        "defaults": [["v"]]
      },
      {
        "id": "handTool",
        "label": "Hand tool",
        "contexts": ["map"],
        "defaults": [["h"]]
      },
      {
        "id": "pencilTool",
        "label": "Pencil tool",
        "contexts": ["map"],
        "defaults": [["p"]]
      },
      {
        "id": "penTool",
        "label": "Pen tool",
        "contexts": ["map"],
        "defaults": [["n"]]
      },
      {
        "id": "bucketTool",
        "label": "Bucket tool",
        "contexts": ["map"],
        "defaults": [["b"]]
      },
      {
        "id": "areaTool",
        "label": "Area tool",
        "contexts": ["map"],
        "defaults": [["a"]]
      },
      {
        "id": "insertTool",
        "label": "Insert tool",
        "contexts": ["map"],
        "defaults": [["i"]]
      },
      {
        "id": "textTool",
        "label": "Text tool",
        "contexts": ["map"],
        "defaults": [["t"]]
      },
      {
        "id": "ellipseTool",
        "label": "Ellipse tool",
        "contexts": ["map"],
        "defaults": [["o"]]
      },
      {
        "id": "rectangleTool",
        "label": "Rectangle tool",
        "contexts": ["map"],
        "defaults": [["r"]]
      },
      {
        "id": "polygonTool",
        "label": "Polygon tool",
        "contexts": ["map"],
        "defaults": [["s"]]
      },
      {
        "id": "eraserTool",
        "label": "Eraser tool",
        "contexts": ["map"],
        "defaults": [["e"]]
      },
      {
        "id": "roughen",
        "label": "Roughen",
        "contexts": ["map"],
        "defaults": [["Mod+Shift+r"]]
      },
      {
        "id": "nextMapStyle",
        "label": "Next Map Style",
        "contexts": ["map"]
      },
      {
        "id": "deleteElement",
        "label": "Delete element",
        "contexts": ["map"],
        "defaults": [["Delete"]]
      }
    ],
    "pages": [
      { "id": "maps", "title": "Maps", "command": "openMaps" },
      { "id": "map", "title": "Map", "command": "openMap", "hideTitle": true }
    ],
    "sidebarEntries": [{ "page": "maps", "icon": "map" }],
    "itemMenuEntries": [{ "command": "bookMaps" }]
  }
}
