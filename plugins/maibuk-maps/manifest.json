{
  "manifestVersion": 1,
  "id": "maibuk-maps",
  "name": "Maps",
  "description": "Design maps of your world, a region, or a country and its provinces, in color or print-ready ink.",
  "author": "Maibuk",
  "version": "0.1.0",
  "apiVersion": "^0.1.10",
  "entry": "index.js",
  "platforms": ["web", "desktop"],
  "lifecycle": "on-demand",
  "warmStart": "intent",
  "dataVersion": 1,
  "defaultLanguage": "en",
  "permissions": {
    "required": ["library:read", "editor:write", "files:pick", "files:save"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openMaps",
        "label": "Open Maps",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "bookMaps",
        "label": "Maps",
        "contexts": ["bookEditor"],
        "targets": ["book"]
      }
    ],
    "pages": [{ "id": "maps", "title": "Maps", "command": "openMaps" }],
    "sidebarEntries": [{ "page": "maps", "icon": "map" }],
    "itemMenuEntries": [{ "command": "bookMaps" }]
  }
}
