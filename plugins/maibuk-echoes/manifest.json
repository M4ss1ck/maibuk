{
  "manifestVersion": 1,
  "id": "maibuk-echoes",
  "name": "Echoes",
  "description": "Points out words and phrases repeated closely enough, or often enough, that a reader would notice.",
  "author": "Maibuk",
  "version": "0.2.0",
  "apiVersion": "^0.1.1",
  "entry": "index.js",
  "platforms": ["web", "desktop", "android"],
  "lifecycle": "on-demand",
  "defaultLanguage": "en",
  "permissions": {
    "required": ["library:read", "editor:read", "editor:decorate"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openEchoes",
        "label": "Open Echoes",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "findEchoes",
        "label": "Find echoes",
        "contexts": ["chapterItem"],
        "targets": ["chapter"]
      },
      {
        "id": "toggleHighlights",
        "label": "Toggle echo highlights",
        "contexts": ["editor"],
        "defaults": [["Alt+F7"]]
      },
      {
        "id": "nextEcho",
        "label": "Next echo",
        "contexts": ["editor"],
        "defaults": [["Alt+F8"]]
      },
      {
        "id": "previousEcho",
        "label": "Previous echo",
        "contexts": ["editor"],
        "defaults": [["Alt+Shift+F8"]]
      }
    ],
    "pages": [{ "id": "report", "title": "Echoes", "command": "openEchoes" }],
    "sidebarEntries": [{ "page": "report", "icon": "waves" }],
    "toolbarButtons": [
      {
        "id": "toggleHighlights",
        "command": "toggleHighlights",
        "icon": {
          "elements": [
            ["path", { "d": "M4 4h5" }],
            ["path", { "d": "M4 4v7" }],
            ["path", { "d": "M4 7.5h4" }],
            ["path", { "d": "M4 11h5" }],
            ["path", { "d": "M20 12 14 18 10 14 16 8Z" }],
            ["path", { "d": "M6 21h8" }]
          ]
        },
        "toggle": true
      }
    ],
    "settingsRows": [
      {
        "id": "detection",
        "label": "Echo detection",
        "description": "Choose which echoes to look for, how close they count, and which the editor highlights."
      }
    ],
    "itemMenuEntries": [{ "command": "findEchoes" }]
  }
}
