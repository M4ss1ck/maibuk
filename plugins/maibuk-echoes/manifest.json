{
  "manifestVersion": 1,
  "id": "maibuk-echoes",
  "name": "Echoes",
  "description": "Points out words and phrases repeated closely enough, or often enough, that a reader would notice.",
  "author": "Maibuk",
  "version": "0.1.0",
  "apiVersion": "^0.1",
  "entry": "index.js",
  "platforms": ["web", "desktop"],
  "lifecycle": "on-demand",
  "defaultLanguage": "en",
  "permissions": {
    "required": ["library:read", "editor:read", "editor:decorate"],
    "optional": []
  },
  "contributes": {
    "commands": [
      {
        "id": "openEchoes",
        "label": "Open Echoes",
        "contexts": ["global"],
        "navigates": true
      },
      {
        "id": "findEchoes",
        "label": "Find echoes",
        "contexts": ["chapterItem"],
        "targets": ["book", "chapter"]
      }
    ],
    "pages": [{ "id": "report", "title": "Echoes", "command": "openEchoes" }],
    "sidebarEntries": [{ "page": "report", "icon": "waves" }],
    "settingsRows": [
      {
        "id": "detection",
        "label": "Echo detection",
        "description": "Choose which echoes to look for and how close they count."
      }
    ],
    "itemMenuEntries": [{ "command": "findEchoes" }]
  }
}
