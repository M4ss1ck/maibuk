      }
    },
    {
      "name": "literal writes a punctuation word instead of acting",
      "line": "say literal comma please",
      "before": "",
      "capabilities": { "casing": true, "punctuation": false, "streaming": true },
      "expected": {
        "edits": [{ "kind": "text", "text": "Say comma please" }],
        "state": { "capitalizeNext": false, "noSpaceNext": false },
        "spokenPunctuationCount": 1
      }
