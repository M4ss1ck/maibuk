      "expected": {
        "edits": [{ "kind": "text", "text": "Maria said hi" }],
        "state": { "capitalizeNext": false, "noSpaceNext": false },
        "spokenPunctuationCount": 1
      }
    },
    {
      "name": "prose 'cap' is not a modifier after the rename",
      "line": "He wore a cap and gloves.",
      "before": "",
      "expected": {
        "edits": [{ "kind": "text", "text": "He wore a cap and gloves." }],
        "state": { "capitalizeNext": true, "noSpaceNext": false },
        "spokenPunctuationCount": 0
      }
    },
    {
      "name": "literal without a following phrase stays as prose",
      "line": "It was a literal translation.",
      "before": "",
      "expected": {
        "edits": [{ "kind": "text", "text": "It was a literal translation." }],
        "state": { "capitalizeNext": true, "noSpaceNext": false },
