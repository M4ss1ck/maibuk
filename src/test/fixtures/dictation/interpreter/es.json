{
  "language": "es",
  "capabilities": { "casing": false, "punctuation": false, "streaming": true },
  "cases": [
    {
      "name": "authored line: comma, period, then new paragraph",
      "line": "hola coma cómo estás punto nuevo párrafo el día",
      "before": "",
      "expected": {
        "edits": [
          { "kind": "text", "text": "Hola, cómo estás." },
          { "kind": "paragraph" },
          { "kind": "text", "text": "El día" }
        ],
        "state": { "capitalizeNext": false, "noSpaceNext": false },
        "spokenPunctuationCount": 3
      }
    },
    {
      "name": "real small-es: hola coma como está (accents drift)",
      "line": "hola coma como está",
      "before": "",
      "expected": {
        "edits": [{ "kind": "text", "text": "Hola, como está" }],
        "state": { "capitalizeNext": false, "noSpaceNext": false },
        "spokenPunctuationCount": 1
      }
    },
    {
      "name": "real small-es: dos puntos inside prose",
      "line": "el capítulo tres empieza con dos puntos y una lista",
      "before": "",
      "expected": {
        "edits": [{ "kind": "text", "text": "El capítulo tres empieza con: y una lista" }],
        "state": { "capitalizeNext": false, "noSpaceNext": false },
        "spokenPunctuationCount": 1
      }
    },
    {
