{"summary":{"source":"../public/audio/two_cities_16k.wav","arch":2,"loadMs":171,"audioSec":44.4,"lines":13,"firstPartialMs":{"p50":813.7,"p95":1196.4},"finalMs":{"p50":313.5,"p95":697.3},"engineFinalMs":{"p50":140,"p95":364},"passMs":{"p50":0,"p95":236.8,"max":735.4},"cpuPctOfOneCore":493.1,"rssMB":{"beforeLoad":9,"afterLoad":153,"peak":230}},"trace":[{"start":0.9919999241828918,"duration":3.936000108718872,"firstTextAudio":1.6000000000000003,"completedAudio":5.099999999999998,"text":"It was the best of times. it was the worst of times."},{"start":4.799999713897705,"duration":1.760000228881836,"firstTextAudio":5.599999999999996,"completedAudio":6.5999999999999925,"text":"It was the age of wisdom,"},{"start":6.431999683380127,"duration":2.111999988555908,"firstTextAudio":7.099999999999991,"completedAudio":8.599999999999985,"text":"It was the age of foolishness."},{"start":8.576000213623047,"duration":2.0159997940063477,"firstTextAudio":9.599999999999982,"completedAudio":10.599999999999978,"text":"It was the epoch of belief,"},{"start":10.559999465942383,"duration":2.560000419616699,"firstTextAudio":11.099999999999977,"completedAudio":13.599999999999968,"text":"It was the epoch of incredulity."},{"start":13.215999603271484,"duration":1.9200000762939453,"firstTextAudio":14.099999999999966,"completedAudio":15.59999999999996,"text":"It was the season of light,"},{"start":14.911999702453613,"duration":2.1120004653930664,"firstTextAudio":15.59999999999996,"completedAudio":17.099999999999973,"text":"It was the season of darkness."},{"start":17.312000274658203,"duration":3.4879989624023438,"firstTextAudio":18.099999999999987,"completedAudio":21.10000000000003,"text":"It was the spring of hope, it was the winter of despair."},{"start":20.992000579833984,"duration":3.3599987030029297,"firstTextAudio":21.600000000000037,"completedAudio":24.60000000000008,"text":"We had everything before us. We had nothing before us."},{"start":24.416000366210938,"duration":1.9519996643066406,"firstTextAudio":25.100000000000087,"completedAudio":26.600000000000108,"text":"We were all going direct to heaven,"},{"start":26.336000442504883,"duration":2.2719993591308594,"firstTextAudio":27.100000000000115,"completedAudio":28.700000000000138,"text":"We were all going to act the other way."},{"start":28.86400032043457,"duration":3.775999069213867,"firstTextAudio":29.700000000000152,"completedAudio":32.700000000000195,"text":"In short,, the period was so far like the present period,"},{"start":32.51199722290039,"duration":9.472003936767578,"firstTextAudio":33.2000000000002,"completedAudio":42.40000000000033,"text":"That some of its noisiest authorities insisted on its being received for good or for evil in the superlative degree of comparison only."}]}
