{"summary":{"source":"public/audio/two_cities_16k.wav","arch":4,"loadMs":203,"audioSec":44.4,"lines":13,"firstPartialMs":{"p50":716,"p95":982.7},"finalMs":{"p50":260.2,"p95":594.7},"engineFinalMs":{"p50":171,"p95":592},"passMs":{"p50":1,"p95":353.6,"max":594.7},"cpuPctOfOneCore":58.2,"rssMB":{"beforeLoad":9,"afterLoad":366,"peak":477}},"trace":[{"start":0.9919999241828918,"duration":3.936000108718872,"firstTextAudio":1.6000000000000003,"completedAudio":4.999999999999998,"text":"It was the best of times, it was the worst of times."},{"start":4.799999713897705,"duration":1.760000228881836,"firstTextAudio":5.4999999999999964,"completedAudio":6.5999999999999925,"text":"It was the age of wisdom,"},{"start":6.431999683380127,"duration":2.111999988555908,"firstTextAudio":7.099999999999991,"completedAudio":8.699999999999985,"text":"It was the age of foolishness."},{"start":8.576000213623047,"duration":2.0159997940063477,"firstTextAudio":9.199999999999983,"completedAudio":10.699999999999978,"text":"It was the epoch of belief,"},{"start":10.559999465942383,"duration":2.560000419616699,"firstTextAudio":11.299999999999976,"completedAudio":13.199999999999969,"text":"It was the epoch of incredulity."},{"start":13.215999603271484,"duration":1.9200000762939453,"firstTextAudio":13.899999999999967,"completedAudio":15.199999999999962,"text":"It was a season of light,"},{"start":14.911999702453613,"duration":2.1120004653930664,"firstTextAudio":15.59999999999996,"completedAudio":17.199999999999974,"text":"It was a season of darkness."},{"start":17.312000274658203,"duration":3.4879989624023438,"firstTextAudio":17.899999999999984,"completedAudio":21.10000000000003,"text":"It was the spring of hope. It was the winter of despair."},{"start":20.992000579833984,"duration":3.3599987030029297,"firstTextAudio":21.600000000000037,"completedAudio":24.500000000000078,"text":"We had everything before us, we had nothing before us."},{"start":24.416000366210938,"duration":1.9519996643066406,"firstTextAudio":25.100000000000087,"completedAudio":26.600000000000108,"text":"We were all going direct to heaven,"},{"start":26.336000442504883,"duration":2.2719993591308594,"firstTextAudio":26.900000000000112,"completedAudio":28.700000000000138,"text":"We were all going to act the other way."},{"start":28.86400032043457,"duration":3.775999069213867,"firstTextAudio":29.50000000000015,"completedAudio":32.700000000000195,"text":"In short,, the period was so far like the present period,"},{"start":32.51199722290039,"duration":9.472003936767578,"firstTextAudio":33.400000000000205,"completedAudio":42.00000000000033,"text":"That some of its noisiest authorities insisted on its being received for good or for evil in the superlative degree of comparison only."}]}
