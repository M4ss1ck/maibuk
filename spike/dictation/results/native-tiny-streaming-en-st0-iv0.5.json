{"summary":{"source":"public/audio/two_cities_16k.wav","arch":2,"loadMs":135,"audioSec":44.4,"lines":13,"firstPartialMs":{"p50":913.4,"p95":1281},"finalMs":{"p50":373.2,"p95":672.3},"engineFinalMs":{"p50":93,"p95":189},"passMs":{"p50":0,"p95":263.8,"max":644.3},"cpuPctOfOneCore":496.3,"rssMB":{"beforeLoad":9,"afterLoad":153,"peak":228}},"trace":[{"start":0.9919999241828918,"duration":3.936000108718872,"firstTextAudio":2.0000000000000004,"completedAudio":4.999999999999998,"text":"It was the best of times. it was the worst of times."},{"start":4.799999713897705,"duration":1.760000228881836,"firstTextAudio":5.4999999999999964,"completedAudio":7.099999999999991,"text":"It was the age of wisdom,"},{"start":6.431999683380127,"duration":2.111999988555908,"firstTextAudio":7.099999999999991,"completedAudio":8.599999999999985,"text":"It was the age of foolishness."},{"start":8.576000213623047,"duration":2.0159997940063477,"firstTextAudio":9.599999999999982,"completedAudio":10.599999999999978,"text":"It was the epoch of belief,"},{"start":10.559999465942383,"duration":2.560000419616699,"firstTextAudio":11.099999999999977,"completedAudio":13.599999999999968,"text":"It was the epoch of incredulity."},{"start":13.215999603271484,"duration":1.9200000762939453,"firstTextAudio":14.099999999999966,"completedAudio":15.59999999999996,"text":"It was the season of light,"},{"start":14.911999702453613,"duration":2.1120004653930664,"firstTextAudio":15.59999999999996,"completedAudio":17.199999999999974,"text":"It was the season of darkness."},{"start":17.312000274658203,"duration":3.4879989624023438,"firstTextAudio":18.19999999999999,"completedAudio":21.20000000000003,"text":"It was the spring of hope. It was the winter of despair."},{"start":20.992000579833984,"duration":3.3599987030029297,"firstTextAudio":21.70000000000004,"completedAudio":24.800000000000082,"text":"We had everything before us. We had nothing before us."},{"start":24.416000366210938,"duration":1.9519996643066406,"firstTextAudio":25.30000000000009,"completedAudio":26.80000000000011,"text":"We were all going direct to heaven,"},{"start":26.336000442504883,"duration":2.2719993591308594,"firstTextAudio":27.300000000000118,"completedAudio":28.80000000000014,"text":"We were all going to act the other way."},{"start":28.86400032043457,"duration":3.775999069213867,"firstTextAudio":29.800000000000153,"completedAudio":32.9000000000002,"text":"In short,, the period was so far like the present period,"},{"start":32.51199722290039,"duration":9.472003936767578,"firstTextAudio":33.400000000000205,"completedAudio":42.40000000000033,"text":"That some of its noisiest authorities insisted on its being received for good or for evil in the superlative degree of comparison only."}]}
