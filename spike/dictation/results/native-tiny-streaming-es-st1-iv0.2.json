{"summary":{"source":"public/audio/quijote_es_16k.wav","arch":2,"loadMs":75,"audioSec":120.0,"lines":33,"firstPartialMs":{"p50":956.3,"p95":1339.9},"finalMs":{"p50":122.8,"p95":215.7},"engineFinalMs":{"p50":14,"p95":24},"passMs":{"p50":1,"p95":26.5,"max":97.1},"cpuPctOfOneCore":7.3,"rssMB":{"beforeLoad":9,"afterLoad":118,"peak":155}},"trace":[{"start":10.911999702453613,"duration":2.560000419616699,"firstTextAudio":11.999999999999973,"completedAudio":13.699999999999967,"text":"esta es una grabación de librivox"},{"start":13.600000381469727,"duration":3.3599987030029297,"firstTextAudio":14.599999999999964,"completedAudio":17.099999999999973,"text":"todas las grabaciones de librivox son de dominio público"},{"start":17.02400016784668,"duration":5.08799934387207,"firstTextAudio":17.69999999999998,"completedAudio":22.300000000000047,"text":"para mayor información o para ser un voluntario por favor visite librivox punto org"},{"start":22.59200096130371,"duration":3.647998809814453,"firstTextAudio":23.90000000000007,"completedAudio":26.300000000000104,"text":"grabada por marta arevalo en la ciudad de guatemala guatemala"},{"start":27.200000762939453,"duration":3.6799983978271484,"firstTextAudio":28.000000000000128,"completedAudio":31.100000000000172,"text":"la primera parte del ingenioso hidalgo don quijote de la mancha"},{"start":30.68800163269043,"duration":1.9519977569580078,"firstTextAudio":31.500000000000178,"completedAudio":32.800000000000196,"text":"por miguel de cervantes saavedra"},{"start":32.60799789428711,"duration":2.944000244140625,"firstTextAudio":33.60000000000021,"completedAudio":35.80000000000024,"text":"dedicación al duque de bejar y prólogo"},{"start":36.70399856567383,"duration":1.4080009460449219,"firstTextAudio":37.700000000000266,"completedAudio":38.300000000000274,"text":"al duque de bear"},{"start":38.49599838256836,"duration":1.6319999694824219,"firstTextAudio":39.30000000000029,"completedAudio":40.2000000000003,"text":"marqués de gibralión"},{"start":40.25600051879883,"duration":2.4959983825683594,"firstTextAudio":41.30000000000032,"completedAudio":42.80000000000034,"text":"conde de benalcázar y bañares"},{"start":42.52799987792969,"duration":2.33599853515625,"firstTextAudio":43.50000000000035,"completedAudio":45.00000000000037,"text":"vizconde de la puebla de alcoser"},{"start":44.92799758911133,"duration":3.4240036010742188,"firstTextAudio":45.90000000000038,"completedAudio":48.40000000000042,"text":"señor de las villas de capilla curiel y burguillos"},{"start":49.69599914550781,"duration":8.2239990234375,"firstTextAudio":50.300000000000445,"completedAudio":58.100000000000556,"text":"en fe del buen acogimiento y honra que hace vuestra excelencia a toda suerte de libros como príncipe tan inclinado a favorecer las buenas artes"},{"start":57.7599983215332,"duration":5.152000427246094,"firstTextAudio":58.700000000000564,"completedAudio":63.000000000000625,"text":"mayormente las que por su nobleza no se abaten al servicio y granjerías del vulgo"},{"start":63.104000091552734,"duration":2.3999977111816406,"firstTextAudio":64.00000000000064,"completedAudio":65.60000000000055,"text":"he determinado de sacar a luz"},{"start":65.27999877929688,"duration":2.720001220703125,"firstTextAudio":66.5000000000005,"completedAudio":68.00000000000041,"text":"al ingenioso hidalgo don quijote de la mancha"},{"start":67.83999633789063,"duration":3.1680068969726563,"firstTextAudio":68.80000000000037,"completedAudio":71.10000000000024,"text":"al abrigo del clarísimo nombre de vuestra excelencia"},{"start":70.87999725341797,"duration":1.0880050659179688,"firstTextAudio":71.7000000000002,"completedAudio":72.10000000000018,"text":"a quien"},{"start":71.7760009765625,"duration":3.0400009155273438,"firstTextAudio":72.70000000000014,"completedAudio":75.00000000000001,"text":"con el acatamiento que debo a tanta grandeza"},{"start":74.6240005493164,"duration":3.391998291015625,"firstTextAudio":75.69999999999997,"completedAudio":78.29999999999983,"text":"suplico le reciba agradablemente en su protección"},{"start":78.08000183105469,"duration":7.327995300292969,"firstTextAudio":78.89999999999979,"completedAudio":85.49999999999942,"text":"para que su sombra aunque desnude aquel precioso ornamento de elegancia y erudición de que suelen andar vestidas las obras"},{"start":85.02400207519531,"duration":3.4560012817382813,"firstTextAudio":86.09999999999938,"completedAudio":88.59999999999924,"text":"que se componen en las casas de los hombres que saben"},{"start":88.63999938964844,"duration":3.2320022583007813,"firstTextAudio":89.59999999999918,"completedAudio":91.99999999999905,"text":"o se parecer seguramente en el juicio de algunos que"},{"start":91.68000030517578,"duration":2.944000244140625,"firstTextAudio":92.799999999999,"completedAudio":94.6999999999989,"text":"continiéndose en los límites de su ignorancia"},{"start":94.49600219726563,"duration":4.351997375488281,"firstTextAudio":95.99999999999882,"completedAudio":98.99999999999865,"text":"suenan condenar con más rigor y menos justicia los trabajos ajenos"},{"start":98.81600189208984,"duration":4.991996765136719,"firstTextAudio":99.7999999999986,"completedAudio":103.99999999999837,"text":"que poniendo los ojos la prudencia de vuestra excelencia en mi buen deseo"},{"start":103.90399932861328,"duration":3.6480026245117188,"firstTextAudio":104.89999999999831,"completedAudio":107.69999999999816,"text":"fío que no desdeñarían la cortedad de tan humilde servicio"},{"start":108.47999572753906,"duration":1.9520034790039063,"firstTextAudio":109.49999999999805,"completedAudio":110.59999999999799,"text":"miguel de cervantes saavedra"},{"start":111.71199798583984,"duration":0.99200439453125,"firstTextAudio":112.79999999999787,"completedAudio":112.79999999999787,"text":"prólogo"},{"start":113.05599975585938,"duration":1.6320037841796875,"firstTextAudio":114.09999999999779,"completedAudio":114.69999999999776,"text":"despreocupado lector"},{"start":114.97599792480469,"duration":3.167999267578125,"firstTextAudio":115.89999999999769,"completedAudio":118.19999999999756,"text":"sin juramento me podrás creer que quisiera que este libro"},{"start":117.85599517822266,"duration":1.824005126953125,"firstTextAudio":118.79999999999752,"completedAudio":119.79999999999747,"text":"como hijo del entendimiento"},{"start":119.45600128173828,"duration":0.5439987182617188,"firstTextAudio":null,"completedAudio":119.99999999999746,"text":""}]}
