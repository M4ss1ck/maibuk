{
  "name": "maibuk",
  "private": true,
  "version": "0.4.15",
  "description": "A cross-platform writing app for authors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "tauri": "tauri",
    "build:deb": "tauri build --target x86_64-unknown-linux-gnu --bundles deb",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:arch": "tauri build --target x86_64-unknown-linux-gnu && ./scripts/build-arch-package.sh",
    "build:windows": "tauri build --target x86_64-pc-windows-gnu",
    "build:android": "tauri android build",
    "dev:web": "VITE_BUILD_TARGET=web vite",
    "build:web": "VITE_BUILD_TARGET=web tsc && VITE_BUILD_TARGET=web vite build",
    "preview:web": "VITE_BUILD_TARGET=web vite preview",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "version:bump": "./scripts/bump-version.sh"
  },
