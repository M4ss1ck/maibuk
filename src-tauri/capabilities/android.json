{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android",
  "description": "Capability for the Android main window",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-write",
    "fs:write-files",
    "fs:allow-read",
    "fs:read-files",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "dialog:default",
    "dialog:allow-save",
    "os:default",
    "clipboard-manager:allow-read-text"
  ]
}
