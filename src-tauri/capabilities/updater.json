{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updater",
  "description": "Update (ADR 0037): only the Linux and Windows builds carry the updater plugin",
  "windows": ["main"],
  "platforms": ["linux", "windows"],
  "permissions": [
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install"
  ]
}
