{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maibuk",
  "version": "0.9.0",
  "identifier": "com.massick.maibuk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A writing app for authors",
    "longDescription": "Maibuk is a cross-platform writing application designed for authors. Create books, manage chapters, design covers, and export to EPUB and PDF.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/lib/maibuk/libmoonshine.so": "../vendor/moonshine/linux-x86_64/lib/libmoonshine.so",
          "usr/lib/maibuk/libonnxruntime.so.1": "../vendor/moonshine/linux-x86_64/lib/libonnxruntime.so.1"
        }
      },
      "deb": {
        "depends": [],
        "files": {
          "/usr/lib/maibuk/libmoonshine.so": "../vendor/moonshine/linux-x86_64/lib/libmoonshine.so",
          "/usr/lib/maibuk/libonnxruntime.so.1": "../vendor/moonshine/linux-x86_64/lib/libonnxruntime.so.1"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/lib/maibuk/libmoonshine.so": "../vendor/moonshine/linux-x86_64/lib/libmoonshine.so",
          "/usr/lib/maibuk/libonnxruntime.so.1": "../vendor/moonshine/linux-x86_64/lib/libonnxruntime.so.1"
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["maibuk"]
      },
      "mobile": [{ "scheme": ["maibuk"], "appLink": false }]
    }
  }
}
